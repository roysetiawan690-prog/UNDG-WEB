<!DOCTYPE html>
<html lang="id"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Undangan Pernikahan</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,600&family=Poppins:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#EEF0FB;--card:#fff;--ink:#2E2A5C;--soft:#6C6A99;--ac:#7A67B5;--on:#fff;--line:#D6D3EE;--b1:#CDBFF2;--b2:#BCD0F4;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
:root[data-theme=melati]{--bg:#F1F5EF;--ink:#1E3A2D;--soft:#5C7466;--ac:#4F7D63;--line:#CFDCD2;--b1:#C3DBC8;--b2:#E5EEC9}
:root[data-theme=mawar]{--bg:#FBE9EE;--card:#FFF7F9;--ink:#5A1F36;--soft:#94586E;--ac:#B5446E;--line:#EBC3D0;--b1:#F5B9CB;--b2:#FADBBF}
:root[data-theme=senja]{--bg:#1D2050;--card:#2A2D68;--ink:#F3EEFB;--soft:#B9B6DE;--ac:#F2B49B;--on:#2A1E3F;--line:#42468A;--b1:#4A3F9B;--b2:#7A4E8F}
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth}
body{margin:0;padding-bottom:96px;color:var(--ink);font:400 16px/1.65 Poppins,system-ui,sans-serif;background:radial-gradient(circle at 0 0,var(--b1),transparent 40%) fixed,radial-gradient(circle at 100% 100%,var(--b2),transparent 42%) fixed,var(--bg)}
h1,h2,h3{font-family:"Playfair Display",Georgia,serif;font-style:italic;font-weight:600;line-height:1.15;margin:0}
section{max-width:520px;margin:0 auto;padding:64px 22px;text-align:center}
h2{font-size:2.1rem;margin-bottom:22px}
p{margin:0 0 12px}.soft{color:var(--soft)}
a{color:inherit}:focus-visible{outline:3px solid var(--ac);outline-offset:3px}
.btn{display:inline-block;border:0;border-radius:12px;padding:11px 24px;background:var(--ac);color:var(--on);font:500 .95rem Poppins,sans-serif;text-decoration:none;cursor:pointer}
.btn.g{background:transparent;color:var(--ink);border:1.5px solid var(--ac)}
.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:24px 20px;margin-bottom:16px}
.card h3{font-size:1.7rem;margin-bottom:6px}.card .t{color:var(--ac);font-weight:500}
#cv{position:fixed;inset:0;z-index:30;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:28px;text-align:center;color:#fff;background:linear-gradient(rgba(20,16,40,.5),rgba(20,16,40,.72)),var(--cv,linear-gradient(160deg,var(--ac),var(--b1)));background-size:cover;background-position:center;transition:transform .9s cubic-bezier(.7,0,.2,1)}
#cv.up{transform:translateY(-100%)}
#cv h1{font-size:clamp(2.8rem,13vw,4.6rem)}#cv .to{margin-top:22px}#cv b{display:block;font:600 1.5rem "Playfair Display",serif;margin:2px 0 16px}
.hero h1{font-size:clamp(3rem,14vw,5rem)}
.cd{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:22px 0}
.cd div{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px 2px}
.cd b{display:block;font:600 1.7rem "Playfair Display",serif;line-height:1.1}.cd span{font-size:.78rem;color:var(--soft)}
.pf{width:150px;height:190px;margin:0 auto 14px;border-radius:75px 75px 12px 12px;overflow:hidden;border:3px solid var(--ac);background:var(--line)}
.pf img,.gal img{width:100%;height:100%;object-fit:cover;display:block}
.ph{width:100%;height:100%;display:grid;place-items:center;font:600 2.4rem "Playfair Display",serif;color:var(--ac);background:linear-gradient(150deg,var(--line),var(--b1))}
.gal{display:grid;grid-template-columns:1fr 1fr;gap:10px}.gal>*{aspect-ratio:1;border-radius:14px;overflow:hidden}
.st{display:flex;gap:14px;text-align:left;margin-bottom:16px}.st b{color:var(--ac);min-width:58px;font:600 1.2rem "Playfair Display",serif}
.no{font:600 1.4rem "Playfair Display",serif;letter-spacing:.04em}
form{text-align:left}label{display:block;font-size:.88rem;font-weight:500;margin-top:10px}
input,select,textarea{width:100%;margin-top:4px;padding:10px 12px;border-radius:10px;border:1.5px solid var(--line);background:var(--card);color:var(--ink);font:inherit}
#nav{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(12px + env(safe-area-inset-bottom,0px));z-index:20;display:flex;gap:2px;padding:6px;border-radius:18px;background:var(--ac);width:min(420px,calc(100% - 24px))}
#nav a{flex:1;text-align:center;text-decoration:none;color:var(--on);font-size:.68rem;line-height:1.3;padding:4px 0}#nav a i{display:block;font-style:normal;font-size:1.15rem}
@media (prefers-reduced-motion:reduce){#cv{transition:none}html{scroll-behavior:auto}}
</style></head>
<body><div id="inv"></div>
<script>
/* =====================================================
   EDIT DATA UNDANGAN DI SINI SAJA (bagian lain jangan diubah)
   ===================================================== */
const DATA = {
  tema: "lavender",              // lavender | melati | mawar | senja
  pria:   { panggilan: "Raka",    lengkap: "Raka Pratama, S.T.",     ortu: "Putra Bapak Hendra & Ibu Sari",     foto: "" },
  wanita: { panggilan: "Anindya", lengkap: "Anindya Kusuma, S.Pd.",  ortu: "Putri Bapak Agus & Ibu Lestari",    foto: "" },
  sampul: "",                    // alamat foto sampul, contoh: "foto/sampul.jpg"
  kalimat: "Dengan penuh syukur, kami mengundang Anda untuk hadir dan mendoakan hari bahagia kami.",
  acara: [
    { nama: "Akad Nikah", tanggal: "2026-12-12", jamMulai: "08:00", jamTeks: "08.00 – 10.00 WIB", tempat: "Masjid Agung, Semarang",      peta: "https://www.google.com/maps/search/?api=1&query=Semarang" },
    { nama: "Resepsi",    tanggal: "2026-12-12", jamMulai: "11:00", jamTeks: "11.00 – 14.00 WIB", tempat: "Gedung Graha Asri, Semarang", peta: "https://www.google.com/maps/search/?api=1&query=Semarang" }
  ],
  live: "",                      // link live streaming (kosongkan jika tidak ada)
  cerita: [
    { tahun: "2022", teks: "Pertama bertemu di sebuah acara kampus." },
    { tahun: "2024", teks: "Memutuskan untuk melangkah ke jenjang serius." },
    { tahun: "2026", teks: "Dengan restu keluarga, kami melangkah ke pelaminan." }
  ],
  galeri: [],                    // contoh: ["foto/1.jpg","foto/2.jpg"]
  rekening: [
    { bank: "BCA",     no: "1234567890", nama: "Raka Pratama" },
    { bank: "Mandiri", no: "9876543210", nama: "Anindya Kusuma" }
  ],
  whatsapp: "6281234567890"      // nomor WA penerima RSVP, awali 62
};
/* ================= BATAS EDIT ================= */

const $=s=>document.querySelector(s),E=t=>String(t==null?'':t).replace(/[&<>"']/g,c=>'&#'+c.charCodeAt(0)+';');
const D=DATA,P=new URLSearchParams(location.search);
const fmt=d=>new Date(d+'T00:00:00+07:00').toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Jakarta'});
const ph=(s,l)=>s?`<img src="${E(s)}" alt="${E(l)}">`:`<div class="ph">${E(l[0])}</div>`;
const a=D.pria.panggilan,b=D.wanita.panggilan,e0=D.acara[0],to=P.get('to')||'Tamu Undangan';
document.documentElement.dataset.theme=P.get('tema')||D.tema;
document.title='Undangan '+a+' & '+b;
const d0=e0.tanggal.replace(/-/g,''),hh=e0.jamMulai.slice(0,2),mm=e0.jamMulai.slice(3,5);
const cal='https://calendar.google.com/calendar/render?action=TEMPLATE&text='+encodeURIComponent('Pernikahan '+a+' & '+b)+'&dates='+d0+'T'+hh+mm+'00/'+d0+'T'+String(Math.min(23,+hh+2)).padStart(2,'0')+mm+'00&location='+encodeURIComponent(e0.tempat);
document.body.style.overflow='hidden';
$('#inv').innerHTML=`
<div id="cv" style="${D.sampul?`--cv:url('${E(D.sampul)}')`:''}"><p>The Wedding Of</p><h1>${E(a)} &amp; ${E(b)}</h1><div class="to"><p>Kepada Yth.</p><b>${E(to)}</b><p>Di Tempat</p><button class="btn" id="ob">Buka Undangan</button></div></div>
<section id="h" class="hero"><p class="soft">The Wedding Of</p><h1>${E(a)} &amp; ${E(b)}</h1><p class="soft" style="margin-top:14px">${E(D.kalimat)}</p>
<div class="cd"><div><b id="cd">0</b><span>hari</span></div><div><b id="ch">0</b><span>jam</span></div><div><b id="cm">0</b><span>menit</span></div><div><b id="cs">0</b><span>detik</span></div></div>
<p><b>${fmt(e0.tanggal)}</b></p><a class="btn" target="_blank" rel="noopener" href="${E(cal)}">Simpan tanggal</a></section>
<section id="m"><h2>Mempelai</h2>
${[D.pria,D.wanita].map(x=>`<div class="card"><div class="pf">${ph(x.foto,x.panggilan)}</div><h3>${E(x.lengkap)}</h3><p class="soft">${E(x.ortu)}</p></div>`).join('')}</section>
<section id="e"><h2>Acara</h2>
${D.acara.map(e=>`<div class="card"><h3>${E(e.nama)}</h3><p>${fmt(e.tanggal)}</p><p class="t">${E(e.jamTeks)}</p><p>${E(e.tempat)}</p><a class="btn g" target="_blank" rel="noopener" href="${E(e.peta)}">Lihat lokasi</a></div>`).join('')}
${D.live?`<div class="card"><h3>Live Streaming</h3><p class="soft">Saksikan acara kami secara virtual.</p><a class="btn" target="_blank" rel="noopener" href="${E(D.live)}">Tonton live</a></div>`:''}</section>
<section id="c"><h2>Cerita Kami</h2>${D.cerita.map(s=>`<div class="st"><b>${E(s.tahun)}</b><span>${E(s.teks)}</span></div>`).join('')}</section>
<section id="g"><h2>Galeri</h2><div class="gal">${D.galeri.length?D.galeri.map(s=>`<div><img src="${E(s)}" alt="Foto galeri"></div>`).join(''):'<div class="ph">❀</div>'.repeat(4)}</div></section>
<section id="k"><h2>Kirim Hadiah</h2><p class="soft">Doa restu Anda sudah cukup bagi kami. Bila ingin berbagi kebahagiaan, silakan melalui:</p>
${D.rekening.map((x,i)=>`<div class="card"><p class="soft">${E(x.bank)}</p><div class="no">${E(x.no)}</div><p class="soft">a.n. ${E(x.nama)}</p><button class="btn g" data-cp="${i}">Salin nomor</button></div>`).join('')}</section>
<section id="r"><h2>RSVP &amp; Ucapan</h2><form id="rf"><label>Nama<input id="rn" required></label>
<label>Kehadiran<select id="rs"><option>Hadir</option><option>Tidak bisa hadir</option></select></label>
<label>Jumlah tamu<input id="rj" type="number" min="1" max="10" value="1"></label>
<label>Ucapan &amp; doa<textarea id="ru" rows="3"></textarea></label><p style="margin-top:14px"><button class="btn" type="submit">Kirim lewat WhatsApp</button></p></form></section>
<nav id="nav"><a href="#h"><i>🏠</i>Beranda</a><a href="#m"><i>💑</i>Mempelai</a><a href="#e"><i>📅</i>Acara</a><a href="#g"><i>🖼️</i>Galeri</a><a href="#r"><i>💌</i>RSVP</a></nav>`;

function tick(){
  let s=Math.max(0,Math.floor((new Date(e0.tanggal+'T'+e0.jamMulai+':00+07:00')-new Date())/1000));
  const set=(i,v)=>{$('#'+i).textContent=v};
  set('cd',Math.floor(s/86400));s%=86400;set('ch',Math.floor(s/3600));s%=3600;set('cm',Math.floor(s/60));set('cs',s%60);
}
tick();setInterval(tick,1000);
$('#inv').addEventListener('click',async e=>{
  if(e.target.id==='ob'){$('#cv').classList.add('up');document.body.style.overflow='';$('#h').scrollIntoView()}
  const i=e.target.dataset&&e.target.dataset.cp;
  if(i!==undefined){const x=e.target;try{await navigator.clipboard.writeText(D.rekening[i].no);x.textContent='Nomor tersalin'}catch(_){x.textContent='Salin manual ya'}setTimeout(()=>x.textContent='Salin nomor',2000)}
});
$('#inv').addEventListener('submit',e=>{
  e.preventDefault();
  const m=`Halo, saya ${$('#rn').value}. Konfirmasi: ${$('#rs').value}, ${$('#rj').value} orang.${$('#ru').value?`\nUcapan: ${$('#ru').value}`:''}`;
  window.open('https://wa.me/'+D.whatsapp+'?text='+encodeURIComponent(m),'_blank','noopener');
});
</script></body></html>
